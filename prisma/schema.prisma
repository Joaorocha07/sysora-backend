generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Papel do usuário dentro de uma empresa. O admin master (dono do SaaS) não é
// um papel de empresa: é User.isSuperAdmin.
enum Role {
  ADMIN
  EMPLOYEE
}

// Vínculo pedido pelo próprio funcionário (tela de cadastro) aguarda o admin aprovar.
enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

// Quem criou/alterou: o bot do WhatsApp ou a equipe pelo sistema.
enum Source {
  BOT
  STAFF
}

// Remetente de uma mensagem da conversa com o cliente.
enum MessageSender {
  CLIENT
  BOT
  STAFF
}

// Item do catálogo: serviço com horário (entra na agenda) ou produto de pronta
// entrega (sem duração: vai junto num agendamento ou é vendido pela equipe).
enum ServiceKind {
  SERVICE
  PRODUCT
}

// Planos pagos (limites e preços em src/lib/plans.ts).
enum Plan {
  INICIAL
  AVANCADO
}

// TRIAL: teste grátis até trialEndsAt. ACTIVE: pago até paidUntil.
// PAST_DUE: pagamento atrasado (ainda dentro da tolerância). CANCELED: sem acesso.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

// Assinatura de um cliente do SaaS. O plano é da conta, não da empresa: no
// Avançado o mesmo dono tem até duas empresas, cada uma com o seu WhatsApp.
model Account {
  id               String             @id @default(uuid())
  name             String
  plan             Plan               @default(INICIAL)
  status           SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime?
  paidUntil        DateTime?
  mpSubscriptionId String?
  // Cortesia (teste, parceiro): plano liberado sem cobrança. Não entra como venda no painel master.
  complimentary    Boolean            @default(false)
  // Uso de IA no mês (AAAA-MM), somado entre as empresas da conta (lib/aiQuota.ts).
  soraMonth        String?
  soraCount        Int                @default(0)
  botAiMonth       String?
  botAiCount       Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  companies Company[]

  @@map("accounts")
}

// Configurações da plataforma, alteradas pelo admin master no painel.
// Linha única (id = 1).
model PlatformSettings {
  id                  Int      @id @default(1)
  // Cadastro de empresas pelo site (/cadastro). false = só o admin master cria empresas.
  publicSignupEnabled Boolean  @default(true)
  // Créditos colocados na conta da Anthropic (centavos de dólar), para o saldo estimado da IA no painel master.
  aiCreditCents       Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@map("platform_settings")
}

// Consumo da IA (Claude) por chamada: tokens e custo estimado pela tabela de
// preços (lib/aiPricing.ts). Alimenta o painel master de gastos com IA.
model AiUsage {
  id               String   @id @default(uuid())
  companyId        String?
  feature          String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  // Custo em milionésimos de dólar (US$ 0,10 = 100000).
  costMicros       Int
  createdAt        DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([companyId])
  @@map("ai_usage")
}

// Uma empresa (tenant). Todo dado de negócio pertence a uma Company, e cada
// Company tem a sua própria conexão de WhatsApp.
model Company {
  id         String   @id @default(uuid())
  accountId  String
  name       String
  slug       String   @unique
  document   String?
  phone      String?
  email      String?
  // Código que o funcionário informa no cadastro para pedir acesso à empresa.
  inviteCode String   @unique
  // Empresa criada pelo cadastro público do site (e não pelo admin master).
  selfSignup Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships      CompanyMembership[]
  clients          Client[]
  services         Service[]
  appointments     Appointment[]
  messages         Message[]
  settings         CompanySettings?
  refreshTokens    RefreshToken[]
  whatsappSessions WhatsAppSession[]
  whatsappAuth     WhatsAppAuth[]
  whatsappCloud    WhatsAppCloudAccount?
  whatsappUsage    WhatsAppUsage[]
  emailInboxes     EmailInbox[]
  soraConversations SoraConversation[]
  account          Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  aiUsage          AiUsage[]
  surveys          OnboardingSurvey[]

  @@index([accountId])
  @@map("companies")
}

// Conta de usuário. O e-mail é único no sistema; o acesso a cada empresa é
// controlado por CompanyMembership.
model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  phone          String?
  passwordHash   String
  active         Boolean   @default(true)
  // Admin master: gerencia todas as empresas do SaaS e pode entrar em
  // qualquer uma com permissão de administrador.
  isSuperAdmin   Boolean   @default(false)
  // Foto do perfil do Google, atualizada a cada login com Google.
  avatarUrl      String?
  // Primeira vez que entrou com Google (nulo = só usa e-mail e senha).
  googleLinkedAt DateTime?
  lastLoginAt    DateTime?
  // Pesquisa inicial: escolheu "Agora não" no convite (o painel segue lembrando).
  surveyDismissedAt DateTime?
  // LGPD: aceite dos Termos de Uso e da Política de Privacidade no cadastro
  // (versão = data da política aceita; lib/legal.ts).
  termsAcceptedAt   DateTime?
  termsVersion      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships   CompanyMembership[]
  refreshTokens RefreshToken[]
  appointments  Appointment[]       @relation("AppointmentStaff")
  survey        OnboardingSurvey?
  privacyRequests PrivacyRequest[]
  soraConversations SoraConversation[]

  @@map("users")
}

// Vínculo do usuário com uma empresa + papel dentro dela.
model CompanyMembership {
  id        String           @id @default(uuid())
  userId    String
  companyId String
  role      Role             @default(EMPLOYEE)
  active    Boolean          @default(true)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  // Quando o admin aprovou ou recusou o pedido de acesso (nulo para quem foi adicionado direto).
  decidedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_memberships")
}

// Refresh tokens opacos com rotação. Só o hash (SHA-256) fica no banco.
// companyId nulo = sessão do admin master no painel master.
model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  companyId           String?
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Cliente final da empresa. Criado à mão pela equipe ou automaticamente pelo
// bot quando alguém manda mensagem no WhatsApp.
model Client {
  id            String    @id @default(uuid())
  companyId     String
  name          String
  phone         String
  email         String?
  birthday      String?
  notes         String?
  // wa_id do WhatsApp (ex.: 5531999999999), destino das mensagens do sistema.
  whatsappId    String?
  // Respondeu "PARAR": não recebe lembretes automáticos pelo WhatsApp.
  whatsappOptOutAt DateTime?
  source        Source    @default(STAFF)
  lastMessageAt DateTime?
  // Mensagens do cliente ainda não vistas pela equipe (caixa de conversas).
  unreadCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  messages     Message[]
  emailAccess  ClientEmailAccess[]

  @@index([companyId])
  @@index([companyId, whatsappId])
  @@map("clients")
}

// Serviço oferecido pela empresa (ex.: corte, consulta, aula experimental) ou
// produto de pronta entrega (ex.: pomada, shampoo), com preço e sem duração.
model Service {
  id              String      @id @default(uuid())
  companyId       String
  kind            ServiceKind @default(SERVICE)
  name            String
  description     String?
  // Produtos: 0 (não ocupam horário na agenda).
  durationMinutes Int         @default(60)
  // Preço em centavos, para não perder precisão.
  priceCents      Int      @default(0)
  active          Boolean  @default(true)
  // Ordem na lista oferecida pelo bot.
  position        Int      @default(0)
  // Produto que é uma conta de acesso (códigos por e-mail): o bot pergunta o
  // e-mail ao cliente, acha a conta mais parecida e entrega o código dela.
  accessEmail     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments AppointmentItem[]

  @@index([companyId])
  @@map("services")
}

// Horário marcado. date/startTime/endTime ficam no fuso da empresa (TZ do
// servidor) como texto: AAAA-MM-DD e HH:mm.
model Appointment {
  id                 String            @id @default(uuid())
  companyId          String
  clientId           String
  staffId            String?
  date               String
  startTime          String
  endTime            String
  status             AppointmentStatus @default(SCHEDULED)
  source             Source            @default(STAFF)
  notes              String?
  totalCents         Int               @default(0)
  // Lembretes do bot (véspera e pouco antes) e resposta do cliente.
  reminderSentAt     DateTime?
  hourReminderSentAt DateTime?
  confirmedAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff   User?             @relation("AppointmentStaff", fields: [staffId], references: [id], onDelete: SetNull)
  items   AppointmentItem[]

  @@index([companyId, date])
  @@index([clientId])
  @@map("appointments")
}

// Serviços de um agendamento. Guarda nome, duração e preço do momento da
// marcação: mudar o catálogo depois não altera agendamentos antigos.
model AppointmentItem {
  id              String      @id @default(uuid())
  appointmentId   String
  serviceId       String?
  kind            ServiceKind @default(SERVICE)
  name            String
  durationMinutes Int
  priceCents      Int

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@map("appointment_items")
}

// Histórico da conversa no WhatsApp com o cliente.
model Message {
  id        String        @id @default(uuid())
  companyId String
  clientId  String
  text      String
  sender    MessageSender
  // Nome de quem da equipe respondeu pelo sistema.
  staffName String?
  createdAt DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([companyId, createdAt])
  @@map("messages")
}

model CompanySettings {
  companyId String @id

  // Horário de funcionamento (usado pelo bot e pela agenda).
  // workDays: 0 = domingo ... 6 = sábado.
  openingTime  String  @default("09:00")
  closingTime  String  @default("18:00")
  workDays     Int[]   @default([1, 2, 3, 4, 5, 6])
  // Grade de horários oferecida pelo bot e quantos atendimentos simultâneos.
  slotMinutes  Int     @default(30)
  slotCapacity Int     @default(1)
  lunchEnabled Boolean @default(false)
  lunchStart   String  @default("12:00")
  lunchEnd     String  @default("13:00")

  // WhatsApp conectado pelo QR Code (WhatsApp Web).
  whatsappConnected Boolean @default(false)
  whatsappPhone     String?

  // Chatbot. As mensagens aceitam {nome}, {empresa}, {servico}, {data} e {hora}.
  botEnabled          Boolean @default(true)
  // Opção "Receber código" do bot (códigos que chegam por e-mail). Só o admin master liga.
  emailCodesEnabled   Boolean @default(false)
  autoCreateClient    Boolean @default(true)
  askName             Boolean @default(true)
  greetingMessage     String  @default("Olá, {nome}! Bem-vindo(a) à {empresa}.")
  handoffMessage      String  @default("Certo! Uma pessoa da nossa equipe vai te responder por aqui em instantes.")
  confirmationMessage String  @default("Agendado! {servico} no dia {data} às {hora}. Até lá, {nome}!")
  reminderEnabled     Boolean @default(true)
  reminderTime        String  @default("10:00")
  reminderMessage     String  @default("Oi, {nome}! Passando para lembrar do seu horário amanhã: {servico} no dia {data} às {hora}.")
  hourReminderEnabled Boolean @default(true)
  hourReminderMinutes Int     @default(60)
  hourReminderMessage String  @default("Oi, {nome}! Seu horário é hoje às {hora}: {servico}. Te esperamos!")
  // Quando a equipe responde, o bot fica em silêncio com o cliente até
  // humanTimeoutMinutes sem mensagem da equipe.
  pauseOnStaffReply   Boolean @default(true)
  humanTimeoutMinutes Int     @default(30)
  humanEndMessage     String  @default("Seu atendimento com a nossa equipe foi encerrado. Obrigado pelo contato!")
  // Fluxo do bot montado na aba "Fluxo do bot" (whatsapp.flow.ts). Nulo = menu padrão.
  botFlow             Json?
  // Uso da Sora (IA que monta o fluxo) no mês corrente, para o limite mensal.
  soraMonth           String?
  soraCount           Int     @default(0)
  // IA do atendimento (whatsapp.ai.ts): entende mensagens escritas livremente
  // quando não são o número de uma opção. Uso no mês, para o limite mensal.
  botAiEnabled        Boolean @default(true)
  botAiMonth          String?
  botAiCount          Int     @default(0)
  // Áudios do cliente viram texto (lib/transcription.ts) e seguem o mesmo atendimento.
  transcribeAudio     Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

// Estado da conversa do bot com um número (menu, etapas do agendamento ou
// HUMAN = equipe atendendo). Apagado quando o fluxo termina ou expira.
model WhatsAppSession {
  id        String   @id @default(uuid())
  companyId String
  phone     String
  step      String
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, phone])
  @@map("whatsapp_sessions")
}

// Credenciais do WhatsApp Web (Baileys) de cada empresa, criptografadas.
model WhatsAppAuth {
  companyId String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, key])
  @@map("whatsapp_auth")
}

// Número conectado pela API oficial do WhatsApp (Cloud API da Meta). Duas
// formas: pelo cadastro incorporado (Embedded Signup, app do Sysora) ou
// manual (manual = true: a empresa criou o próprio app na Meta e colou as
// credenciais). A conta do WhatsApp (WABA) é do cliente e a Meta cobra as
// mensagens direto dele (whatsapp.cloud.ts).
model WhatsAppCloudAccount {
  companyId     String    @id
  wabaId        String
  phoneNumberId String    @unique
  businessId    String?
  // Token do cliente (de integração ou de usuário do sistema), criptografado (lib/crypto.ts).
  accessToken   String
  manual        Boolean   @default(false)
  // App da Meta do próprio cliente (conexão manual): o segredo, criptografado,
  // confere a assinatura do webhook dele.
  appId         String?
  appSecret     String?
  // Último webhook recebido e conferido, para a tela mostrar se está chegando.
  lastWebhookAt DateTime?
  // PIN da verificação em duas etapas definido no registro, criptografado.
  pin           String?
  displayPhone  String?
  verifiedName  String?
  // Número que continua no app WhatsApp Business do celular (coexistência).
  coexistence   Boolean   @default(false)
  // Situação dos templates dos lembretes na Meta: { nome: "APPROVED" | "PENDING" | "REJECTED" ... }.
  templates     Json      @default("{}")
  // Último erro de envio relevante (ex.: sem forma de pagamento na Meta).
  lastError     String?
  lastErrorAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("whatsapp_cloud_accounts")
}

// Mensagens entregues pela API oficial no mês (AAAA-MM), por categoria de
// preço da Meta. billable = cobradas pela Meta (campo pricing do webhook).
model WhatsAppUsage {
  companyId              String
  month                  String
  serviceTotal           Int    @default(0)
  serviceBillable        Int    @default(0)
  utilityTotal           Int    @default(0)
  utilityBillable        Int    @default(0)
  marketingTotal         Int    @default(0)
  marketingBillable      Int    @default(0)
  authenticationTotal    Int    @default(0)
  authenticationBillable Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, month])
  @@map("whatsapp_usage")
}

// Pesquisa inicial respondida pelo administrador (como conheceu o Sysora, ramo,
// tamanho da equipe e o que espera de um sistema). Os valores são os ids das
// opções da tela (frontend: lib/survey.ts); "Outro" vem no campo *Other.
model OnboardingSurvey {
  id            String   @id @default(uuid())
  userId        String   @unique
  companyId     String?
  sources       String[]
  sourceOther   String?
  business      String
  businessOther String?
  teamSize      String
  features      String[]
  featuresOther String?
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("onboarding_surveys")
}

// LGPD: escolha de cookies de cada navegador (o id é gerado no navegador e fica
// salvo nele). Serve de prova do consentimento (art. 8º, § 2º). O IP é guardado
// só como hash.
model CookieConsent {
  id            String   @id
  userId        String?
  analytics     Boolean  @default(false)
  marketing     Boolean  @default(false)
  policyVersion String
  ipHash        String?
  userAgent     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("cookie_consents")
}

// LGPD: pedido do titular dos dados (art. 18): acesso, correção, exclusão,
// revogação de consentimento etc. Atendido pelo admin master (painel
// Privacidade), com prazo de 15 dias para a resposta completa (art. 19).
model PrivacyRequest {
  id         String    @id @default(uuid())
  userId     String
  type       String
  message    String?
  status     String    @default("OPEN")
  response   String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("privacy_requests")
}

// Caixa de e-mail (Gmail, por IMAP com senha de app) de onde o bot busca
// códigos de acesso para mandar ao cliente (opção "Receber código" do fluxo).
model EmailInbox {
  id          String   @id @default(uuid())
  companyId   String
  label       String
  email       String
  // Senha de app do Google, criptografada (lib/crypto.ts).
  passwordEnc String
  // Domínios ou e-mails remetentes aceitos, separados por vírgula.
  senders     String
  active      Boolean  @default(true)
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clients ClientEmailAccess[]

  @@unique([companyId, email])
  @@map("email_inboxes")
}

// Clientes que podem receber os códigos de cada caixa.
model ClientEmailAccess {
  clientId String
  inboxId  String

  client Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  inbox  EmailInbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@id([clientId, inboxId])
  @@index([inboxId])
  @@map("client_email_access")
}

// Conversas com a Sora (menu Sora e painel do Fluxo do bot), salvas para o
// histórico. source: "chat" (menu Sora) ou "fluxo" (editor do fluxo).
model SoraConversation {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  title     String
  source    String   @default("chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages SoraMessage[]

  @@index([companyId, updatedAt])
  @@map("sora_conversations")
}

// payload (respostas da Sora): fluxo proposto e/ou mudanças no catálogo, e
// quando o catálogo foi aplicado (catalogAppliedAt).
model SoraMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  text           String
  payload        Json?
  createdAt      DateTime @default(now())

  conversation SoraConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("sora_messages")
}
