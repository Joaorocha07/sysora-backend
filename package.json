{
  "name": "sysora-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend do Sysora: SaaS de cadastro de clientes, serviços e agendamentos com chatbot de WhatsApp.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/db-guard.js migrate dev",
    "prisma:deploy": "node scripts/db-guard.js migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "ts-node-dev --transpile-only prisma/seed.ts",
    "db:local": "node scripts/local-db.mjs",
    "prisma:status": "node scripts/db-guard.js migrate status",
    "db:backup": "node scripts/db-backup.js",
    "db:check": "node scripts/db-check.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.117.2",
    "baileys": "^7.0.0-rc14",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "imapflow": "^2.2.5",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.35",
    "mercadopago": "^3.6.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mailparser": "^3.9.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "embedded-postgres": "17.5.0-beta.15",
    "prisma": "^5.20.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
