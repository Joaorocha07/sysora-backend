# --- Banco de dados (PostgreSQL: Neon, Supabase, local...) ---
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/sysora?schema=public"
# Conexão direta (sem pooler), usada pelas migrations. Localmente, igual à DATABASE_URL.
DIRECT_URL="postgresql://postgres:SUA_SENHA@localhost:5432/sysora?schema=public"
# Supabase: use a string do "Session pooler" (botão "Connect" no painel) nas duas:
# postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?schema=public

# --- Login com Google (Supabase Auth) ---
# URL do projeto e chave publicável (Supabase > Project Settings > API Keys).
# Vazias = login com Google desligado.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Servidor ---
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Horários da agenda e do bot usam o relógio do servidor: defina o fuso.
TZ=America/Sao_Paulo
# Em produção atrás de proxy (Render, Railway...): TRUST_PROXY=true.
TRUST_PROXY=false
# Frontend e backend em domínios diferentes (ex.: Vercel + Render): true.
CROSS_SITE_COOKIES=false

# --- JWT ---
# Gere segredos fortes e distintos, ex.: `openssl rand -hex 64`
JWT_ACCESS_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio
JWT_REFRESH_SECRET=troque-este-valor-por-outro-segredo-forte-e-aleatorio
JWT_PREAUTH_SECRET=troque-este-valor-por-mais-um-segredo-forte-e-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_PREAUTH_EXPIRES_IN=5m

# --- Cookie do refresh token ---
# COOKIE_SECURE=true em produção (HTTPS): o navegador só envia o cookie por HTTPS.
REFRESH_COOKIE_NAME=sysora_refresh_token
COOKIE_SECURE=false

# O cadastro público de empresas (/cadastro) é ligado e desligado pelo admin
# master em Painel master > Configurações.

# --- Admin master: SÓ para o `npm run seed` (o servidor não lê) ---
# Cria o primeiro admin master. Depois a senha é trocada no painel master
# (Configurações > Minha conta). Não precisa ir para a produção.
MASTER_NAME="Admin Master"
MASTER_EMAIL=master@sysora.com.br
MASTER_PASSWORD=troque-esta-senha
# true = cria também uma empresa de demonstração
SEED_DEMO=false

# --- WhatsApp ---
# Cada empresa conecta o próprio número pelo QR Code na tela WhatsApp do
# Sysora (WhatsApp Web). A sessão fica no banco, criptografada com uma chave
# derivada do JWT_REFRESH_SECRET: se ele mudar, é preciso ler o QR de novo.
# Rode só UMA instância do backend por banco, senão elas disputam as sessões.
WHATSAPP_ENABLED=true

# --- Mercado Pago (assinaturas recorrentes) ---
# Access Token de produção ou sandbox (MP > Credenciais).
MP_ACCESS_TOKEN=
# IDs dos planos no MP (gerados automaticamente na primeira assinatura e exibidos no log).
MP_PLAN_INICIAL_ID=
MP_PLAN_AVANCADO_ID=

# --- E-mail (recuperação de senha) ---
# Sem SMTP_HOST o link de recuperação só aparece no terminal do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sysora <no-reply@seudominio.com.br>"
APP_URL=http://localhost:3000

# Sora: assistente de IA que monta o fluxo do bot (https://console.anthropic.com).
# Sem a chave, o editor manual do fluxo continua funcionando normalmente.
ANTHROPIC_API_KEY=
SORA_MODEL=claude-opus-5-5
SORA_MONTHLY_LIMIT=50

# IA do atendimento: entende mensagens escritas do jeito do cliente ("quero
# marcar um corte amanhã às 14h") quando não são um número do menu. Usa a mesma
# ANTHROPIC_API_KEY. Haiku: cerca de US$ 0,001 por mensagem interpretada.
BOT_AI_MODEL=claude-haiku-4-5
BOT_AI_MONTHLY_LIMIT=1500

# Transcrição de áudios do WhatsApp (API compatível com a OpenAI). Padrão: Groq
# (https://console.groq.com), cerca de US$ 0,04 por hora de áudio.
# Sem a chave, o bot pede para o cliente digitar.
TRANSCRIBE_API_KEY=
TRANSCRIBE_API_URL=https://api.groq.com/openai/v1
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_USD_PER_HOUR=0.04
TRANSCRIBE_MAX_SECONDS=120
